---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../config';

const metadata = {
  title: '本査定(持込)',
  description: '弊社に骨董品・美術品を持ち込み、専門の鑑定士に査定を依頼しましょう。'
};

const steps = [
  {
    title: '本査定の申し込み',
    description: '事前にかんたん査定を行っていただき、LINEまたはチャットで、下記情報をお伝えください。',
    details: ['お名前', 'ご連絡先', '持ち込み希望日', '持ち込み希望時間'],
    image: '/home/step_line.webp'
  },
  {
    title: '買取規定の最終確認',
    description: '本査定前に買取規約に同意していただく必要があります。必ずこちらをご確認ください。',
    link: '/help/rule',
    image: '/home/step_carryin.webp'
  },
  {
    title: 'ご来店ください',
    description: '持ち込み希望日に、弊社までお越しください。',
    address: company.address.value,
    image: '/home/step_carryin.webp'
  },
  {
    title: '鑑定士による本査定',
    description: '最終的な買取金額を鑑定士が査定します。',
    image: '/home/step_carryin.webp'
  },
  {
    title: '買取金額のお支払い',
    description: '鑑定結果にご納得いただけましたら、買取金額をお支払いします。支払いは現金または銀行振込が可能です。',
    image: '/home/step_carryin.webp'
  }
];
---

<BaseLayout title={metadata.title} description={metadata.description}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">{metadata.title}</h1>
      <p class="text-xl leading-relaxed">{metadata.description}</p>
    </div>

    <!-- Steps -->
    <div class="space-y-8">
      <h2 class="text-2xl font-bold text-center mb-8">本査定(持込)の手順</h2>
      
      <div class="timeline timeline-vertical">
        {steps.map((step, index) => (
          <div class="timeline-item">
            <div class="timeline-start">
              <div class="badge badge-primary badge-lg text-lg font-bold w-10 h-10 p-0">
                {index + 1}
              </div>
            </div>
            <div class="timeline-middle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.236 4.53L8.23 10.661a.75.75 0 00-1.06 1.06l1.615 1.616a.75.75 0 001.137-.082l3.857-5.395z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="timeline-end timeline-box">
              <h3 class="font-bold text-lg mb-2">{step.title}</h3>
              <p class="mb-4">{step.description}</p>
              
              {step.details && (
                <div class="mb-4">
                  <ul class="list-disc list-inside space-y-1">
                    {step.details.map((detail) => (
                      <li class="text-sm">{detail}</li>
                    ))}
                  </ul>
                </div>
              )}
              
              {step.address && (
                <div class="alert alert-info mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span><strong>住所：</strong>{step.address}</span>
                </div>
              )}
              
              {step.link && (
                <div class="mb-4">
                  <a href={step.link} class="btn btn-outline btn-sm">
                    買取規約を確認する
                  </a>
                </div>
              )}
              
              {step.image && (
                <figure class="mt-4">
                  <img 
                    src={step.image} 
                    alt={step.title}
                    class="rounded-lg shadow-md max-w-full h-auto"
                    loading="lazy"
                  />
                </figure>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Company Info -->
    <div class="mt-16">
      <div class="card bg-base-200 shadow-lg">
        <div class="card-body">
          <h3 class="card-title justify-center mb-6">店舗情報</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <span class="text-2xl">🏢</span>
                  <div>
                    <div class="font-semibold">{company.name.value}</div>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-2xl">📍</span>
                  <div>
                    <div class="font-semibold">住所</div>
                    <div>{company.address.value}</div>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-2xl">📞</span>
                  <div>
                    <div class="font-semibold">電話</div>
                    <a href={`tel:${company.tel.value}`} class="text-primary hover:underline">
                      {company.tel.value}
                    </a>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-2xl">🕐</span>
                  <div>
                    <div class="font-semibold">営業時間</div>
                    <div>{company.business.value}</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex justify-center items-center">
              <div class="mockup-window border bg-base-300">
                <div class="flex justify-center px-4 py-16 bg-base-200">
                  地図表示予定
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="text-center mt-16">
      <div class="card bg-gradient-to-br from-primary to-secondary text-primary-content">
        <div class="card-body">
          <h3 class="card-title justify-center text-2xl mb-4">
            持ち込み査定のお申し込み
          </h3>
          <p class="text-center mb-6">
            まずは無料のかんたん査定から始めましょう
          </p>
          <div class="card-actions justify-center gap-4">
            <a href="/assessments/line" class="btn btn-accent btn-lg">
              LINE査定を始める
            </a>
            <button class="btn btn-outline btn-lg" id="start-chat">
              チャット査定を始める
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const startChatBtn = document.getElementById('start-chat');
    startChatBtn?.addEventListener('click', () => {
      if (typeof window !== 'undefined' && window.Crisp) {
        window.Crisp.chat.open();
      }
    });
  });
</script>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../config';

const metadata = {
  title: '会社概要',
  description: '弊社についての詳細情報を記載します'
};
---

<BaseLayout title={metadata.title} description={metadata.description}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">{metadata.title}</h1>
      <p class="text-xl leading-relaxed">{metadata.description}</p>
    </div>

    <!-- Company Information -->
    <div class="grid md:grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Company Details Table -->
      <div class="order-2 lg:order-1">
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <h2 class="card-title mb-6">会社情報</h2>
            <div class="overflow-x-auto">
              <table class="table table-zebra">
                <tbody>
                  {Object.entries(company).map(([key, item]) => (
                    <tr>
                      <td class="font-medium w-1/3">{item.label}</td>
                      <td>
                        {key === 'email' ? (
                          <a href={`mailto:${item.value}`} class="text-primary hover:underline">
                            {item.value}
                          </a>
                        ) : key === 'tel' ? (
                          <a href={`tel:${item.value}`} class="text-primary hover:underline">
                            {item.value}
                          </a>
                        ) : (
                          item.value
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Company Logo and Description -->
      <div class="order-1 lg:order-2">
        <div class="card bg-gradient-to-br from-primary/5 to-secondary/5 shadow-lg">
          <div class="card-body text-center">
            <figure class="mb-6">
              <svg class="w-24 h-24 mx-auto fill-primary" viewBox="0 0 100 100">
                <use href="/logo.svg#logo"></use>
              </svg>
            </figure>
            <h3 class="card-title justify-center text-2xl mb-4">
              {company.siteName.value}
            </h3>
            <p class="text-base leading-relaxed mb-6">
              確かな目利きと豊富な経験を持つ専門鑑定士が、
              お客様の大切な骨董品・古美術品を丁寧に査定いたします。
              八王子を拠点に、関東・関西エリアでの出張買取も承っております。
            </p>
            <div class="card-actions justify-center">
              <a href="/assessments/line" class="btn btn-primary">
                無料査定を依頼する
              </a>
            </div>
          </div>
        </div>

        <!-- License Information -->
        <div class="card bg-base-100 shadow-lg mt-6">
          <div class="card-body">
            <h3 class="card-title mb-4">許可・資格</h3>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="badge badge-primary badge-sm mt-1">許可</span>
                <div>
                  <div class="font-semibold text-sm">{company.licence.label}</div>
                  <div class="text-sm opacity-70">{company.licence.value}</div>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="badge badge-secondary badge-sm mt-1">登録</span>
                <div>
                  <div class="font-semibold text-sm">{company.licenceIvory.label}</div>
                  <div class="text-sm opacity-70">{company.licenceIvory.value}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Services Section -->
    <div class="mt-16">
      <div class="card bg-base-200 shadow-lg">
        <div class="card-body">
          <h3 class="card-title justify-center text-2xl mb-8">サービス内容</h3>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="text-center">
              <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary-content" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <h4 class="font-bold mb-2">無料査定</h4>
              <p class="text-sm">LINEやチャットで24時間いつでも無料査定</p>
            </div>
            <div class="text-center">
              <div class="w-16 h-16 bg-secondary rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-secondary-content" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 4a1 1 0 011-1h12a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1V8zm5 3a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </div>
              <h4 class="font-bold mb-2">高価買取</h4>
              <p class="text-sm">専門鑑定士による適正価格での買取</p>
            </div>
            <div class="text-center">
              <div class="w-16 h-16 bg-accent rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-accent-content" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
              </div>
              <h4 class="font-bold mb-2">出張買取</h4>
              <p class="text-sm">関東・関西エリアへの無料出張買取</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
---
const heading = {
  title: "骨董品・古美術品の無料鑑定",
  subtitle: "スマホで、かんたん査定",
  description: "開豊ジャパンは、八王子市の古美術品店。確かな目利きと、多数の高価買取実績あり。眠ったままの骨董品、思いの詰まった遺品など、１点１点しっかり丁寧に鑑定します。"
};
---

<div class="hero bg-gradient-to-br from-base-100 to-base-200 min-h-screen">
  <div class="hero-content flex-col lg:flex-row-reverse max-w-6xl">
    
    <!-- Image Content -->
    <div class="flex-1 relative mb-12 md:mb-0 overflow-hidden">
      <img 
        src="/items/other.webp" 
        width="350" 
        height="350" 
        alt="antique item" 
        class="absolute bottom-[30px] animate-fade-in"
        loading="eager"
      />

      <div class="relative transform-origin-bottom-left animate-slide-in-right">
        <div class="flex gap-2 absolute top-24 w-full justify-center opacity-80">
          <img src="/badges/1.webp" width="65" height="65" alt="badge1" />
          <img src="/badges/2.webp" width="65" height="65" alt="badge2" />
          <img src="/badges/3.webp" width="65" height="65" alt="badge3" />
        </div>
        <img 
          src="/home/phone_frame.webp" 
          width="350" 
          height="539" 
          alt="smart phone frame"
          loading="eager"
        />
      </div>
    </div>
    
    <!-- Text Content -->
    <div class="flex-1 text-center lg:text-left">
      <div class="mb-4">
        <div class="badge badge-neutral badge-outline mb-4">専門鑑定士による</div>
      </div>
      <h1 class="text-4xl lg:text-6xl font-light text-base-content mb-2 tracking-tight">
        {heading.title}
      </h1>
      <h2 class="text-xl lg:text-2xl mb-8 text-primary font-medium tracking-wide">
        {heading.subtitle}
      </h2>
      <p class="text-lg leading-relaxed mb-10 max-w-lg text-base-content/70 font-light">
        {heading.description}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <a href="/assessments/line" class="btn btn-primary btn-lg gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 2 0z" />
          </svg>
          査定をはじめる
        </a>
        <button class="btn btn-outline btn-lg gap-2" id="chat-button">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a9.863 9.863 0 01-4.906-1.308L3 21l1.308-5.094A9.863 9.863 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z" />
          </svg>
          チャットで相談
        </button>
      </div>
      
      <div class="mt-12 grid grid-cols-2 gap-8 max-w-md mx-auto lg:mx-0">
        <div class="text-center lg:text-left">
          <div class="text-3xl font-light text-primary mb-1">1000+</div>
          <div class="text-sm text-base-content/60 font-light">年間査定件数</div>
        </div>
        <div class="text-center lg:text-left">
          <div class="text-3xl font-light text-secondary mb-1">98%</div>
          <div class="text-sm text-base-content/60 font-light">満足度</div>
        </div>
      </div>
    </div>
    
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chatButton = document.getElementById('chat-button');
    chatButton?.addEventListener('click', () => {
      // Open Crisp chat if available
      if (typeof window !== 'undefined' && window.Crisp) {
        window.Crisp.chat.open();
      }
    });
  });
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slide-in-right {
    from { 
      transform: rotate(90deg); 
      opacity: 0;
    }
    to { 
      transform: rotate(0deg); 
      opacity: 1;
    }
  }
  
  .animate-fade-in {
    animation: fade-in 1s ease-in-out;
  }
  
  .animate-slide-in-right {
    animation: slide-in-right 0.8s ease-in-out;
  }
</style>
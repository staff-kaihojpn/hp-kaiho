---
const assessmentTypes = [
  {
    title: 'かんたん査定',
    subtitle: 'LINE・チャット',
    description: 'スマホで写真を送るだけ！24時間いつでも気軽に査定依頼',
    features: ['無料査定', '24時間対応', '写真送信のみ'],
    cta: '査定を始める',
    href: '/assessments/line',
    image: '/assessments/line1.webp'
  },
  {
    title: '本格査定',
    subtitle: '訪問・持込',
    description: '専門の鑑定士が直接査定。より正確で高額な査定が可能',
    features: ['専門鑑定士', '高額査定', '即日対応'],
    cta: '訪問査定を依頼',
    href: '/assessments/onsite',
    image: '/assessments/chat1.webp'
  }
];
---

<section class="py-16 bg-gradient-to-br from-primary/5 to-secondary/5">
  <div class="container mx-auto px-4 max-w-4xl">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        査定方法をお選びください
      </h2>
      <p class="text-lg opacity-80">
        お客様のご都合に合わせて、２つの査定方法をご用意
      </p>
    </div>

    <!-- Assessment Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {assessmentTypes.map((assessment) => (
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow duration-300">
          <figure class="px-6 pt-6">
            <img 
              src={assessment.image}
              alt={assessment.title}
              class="rounded-xl h-48 w-full object-cover"
              loading="lazy"
            />
          </figure>
          
          <div class="card-body">
            <div class="badge badge-primary mb-2">{assessment.subtitle}</div>
            <h3 class="card-title text-2xl mb-2">{assessment.title}</h3>
            <p class="text-base-content/80 mb-4">{assessment.description}</p>
            
            <!-- Features -->
            <div class="flex flex-wrap gap-2 mb-6">
              {assessment.features.map((feature) => (
                <div class="badge badge-outline">{feature}</div>
              ))}
            </div>
            
            <!-- CTA Button -->
            <div class="card-actions justify-center">
              <a href={assessment.href} class="btn btn-primary btn-wide">
                {assessment.cta}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Additional Info -->
    <div class="text-center mt-12">
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>すべての査定は無料です。査定後のキャンセルも可能です。</span>
      </div>
    </div>
  </div>
</section>
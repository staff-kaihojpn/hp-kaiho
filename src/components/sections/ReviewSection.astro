---
const reviews = [
  {
    name: '田中様',
    location: '東京都',
    rating: 5,
    comment: '古い茶道具を査定していただきました。想像以上の高額査定で、丁寧な対応にも満足しています。',
    item: '茶道具一式',
    initial: 'T'
  },
  {
    name: '山田様',
    location: '神奈川県',
    rating: 5,
    comment: 'LINEでの査定が本当に簡単でした。写真を送るだけで、すぐに返事をいただけて助かりました。',
    item: '金製品',
    initial: 'Y'
  },
  {
    name: '佐藤様',
    location: '埼玉県',
    rating: 5,
    comment: '遺品整理で困っていましたが、出張査定で全て対応していただけて本当に助かりました。',
    item: '骨董品多数',
    initial: 'S'
  }
];
---

<section class="py-20 bg-base-200">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <div class="badge badge-neutral badge-outline mb-6">お客様の声</div>
      <h2 class="text-3xl md:text-5xl font-light mb-3 tracking-tight">
        ご利用いただいたお客様からの
      </h2>
      <h3 class="text-xl md:text-2xl text-primary font-light mb-8 tracking-wide">
        喜びの声をお届けします
      </h3>
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="rating rating-lg">
          {[...Array(5)].map((_, i) => (
            <input type="radio" class="mask mask-star-2 bg-yellow-400" checked={i === 4} disabled />
          ))}
        </div>
        <span class="text-2xl font-light text-base-content/80">5.0</span>
      </div>
      <p class="text-sm text-base-content/50 font-light">(お客様満足度)</p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 group">
          <div class="card-body">
            <!-- Rating -->
            <div class="rating rating-sm justify-center mb-4">
              {[...Array(5)].map((_, i) => (
                <input type="radio" class="mask mask-star-2 bg-yellow-400" checked={i < review.rating} disabled />
              ))}
            </div>

            <!-- Comment -->
            <div class="chat chat-start">
              <div class="chat-image avatar placeholder">
                <div class="bg-neutral text-neutral-content rounded-full w-10 h-10">
                  <span class="text-sm font-semibold">{review.initial}</span>
                </div>
              </div>
              <div class="chat-bubble chat-bubble-primary text-sm">
                {review.comment}
              </div>
            </div>

            <div class="divider"></div>

            <!-- Customer Info -->
            <div class="flex items-center justify-between">
              <div>
                <div class="font-bold text-sm">{review.name}</div>
                <div class="text-xs opacity-70">{review.location}</div>
              </div>
              <div class="badge badge-outline badge-sm">{review.item}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Stats -->
    <div class="stats shadow-lg bg-base-100 mt-16 mx-auto max-w-4xl">
      <div class="stat place-items-center">
        <div class="stat-title">累計査定件数</div>
        <div class="stat-value text-primary">10,000+</div>
        <div class="stat-desc">2020年〜現在まで</div>
      </div>
      <div class="stat place-items-center">
        <div class="stat-title">お客様満足度</div>
        <div class="stat-value text-secondary">98%</div>
        <div class="stat-desc">★★★★★ 5つ星評価</div>
      </div>
      <div class="stat place-items-center">
        <div class="stat-title">リピート率</div>
        <div class="stat-value text-accent">85%</div>
        <div class="stat-desc">再利用・ご紹介多数</div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <div class="hero bg-gradient-to-r from-primary to-secondary rounded-2xl">
        <div class="hero-content text-center text-primary-content py-12">
          <div class="max-w-2xl">
            <h3 class="text-3xl font-bold mb-4">
              あなたも査定してみませんか？
            </h3>
            <p class="text-lg mb-8 opacity-90">
              無料査定で、あなたの大切な品物の価値を確認してみませんか。
              <br class="hidden sm:block" />
              専門鑑定士が丁寧に査定いたします。
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/assessments/line" class="btn btn-accent btn-lg gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                無料査定を始める
              </a>
              <button class="btn btn-outline btn-lg gap-2" id="review-chat-button">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a9.863 9.863 0 01-4.906-1.308L3 21l1.308-5.094A9.863 9.863 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z" />
                </svg>
                まずは相談
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chatButton = document.getElementById('review-chat-button');
    chatButton?.addEventListener('click', () => {
      if (typeof window !== 'undefined' && window.Crisp) {
        window.Crisp.chat.open();
      }
    });
  });
</script>
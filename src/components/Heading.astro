---
export interface HeadingProps {
  title?: string;
  description?: string;
  className?: string;
}

const { title, description, className = '' } = Astro.props as HeadingProps;
---

<div class={className}>
  {title && (
    <h2 class="font-bold text-2xl md:text-3xl text-primary">{title}</h2>
  )}
  {description && (
    <p class="mt-6">{description}</p>
  )}
</div>
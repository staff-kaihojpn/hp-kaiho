---
export interface StepCardProps {
  step?: number;
  title?: string;
  description?: string;
  image?: string;
  className?: string;
}

const { step, title, description, image, className = '' } = Astro.props as StepCardProps;
---

<div class={`card bg-base-100 shadow-lg border relative ${className}`}>
  {step && (
    <div class="absolute top-0 left-0 w-10 h-10 bg-gradient-to-br from-transparent via-transparent to-success rounded-tl-lg flex items-center justify-center z-10">
      <span class="text-white font-bold text-sm">{step}</span>
    </div>
  )}
  <div class="card-body">
    <div class="flex flex-col sm:flex-row gap-4">
      <div class="flex-1 pt-2">
        {title && <h3 class="card-title font-bold">{title}</h3>}
        {description && <p class="mt-4 text-base-content/70">{description}</p>}
      </div>
      {image && (
        <div class="w-full sm:w-72 aspect-square">
          <img 
            src={image} 
            alt="step-image" 
            class="w-full h-full object-cover rounded-lg"
          />
        </div>
      )}
    </div>
  </div>
</div>
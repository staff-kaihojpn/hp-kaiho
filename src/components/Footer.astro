---
import { config, metadata } from '../config';
import CompanyTable from './CompanyTable.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={[className, "footer footer-center bg-base-300 text-base-content p-10 mt-16"]}>
  <aside>
    <a href="/" aria-label="to home" class="link link-hover">
      <svg class="fill-current w-20 h-20" width="80" height="80">
        <use href="/logo.svg#logo"></use>
      </svg>
    </a>
    <p class="font-bold text-lg">{metadata.title}</p>
    <p class="text-sm opacity-70">
      八王子市の骨董品・古美術品専門店
      <br />
      確かな目利きと高価買取実績
    </p>
  </aside>
  
  <div class="divider"></div>
  
  <div class="grid grid-flow-col gap-8 text-center">
    <CompanyTable />
  </div>
  
  <nav class="grid grid-flow-col gap-8">
    {config.pageGroups.map((group) => (
      <div class="flex flex-col">
        <h6 class="footer-title opacity-100 text-base-content">{group.name}</h6>
        {group.pages?.map((page) => (
          <a href={page.path || ''} class="link link-hover text-sm">
            {page.name}
          </a>
        ))}
      </div>
    ))}
  </nav>
  
  <nav>
    <div class="grid grid-flow-col gap-4">
      <a href={config.link.line} class="link" aria-label="LINE">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.875 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.736c.345 0 .627.283.627.629 0 .344-.282.629-.627.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
        </svg>
      </a>
    </div>
  </nav>
  
  <aside>
    <p class="text-sm">
      &copy; {new Date().getFullYear()} {metadata.title}. All rights reserved.
    </p>
  </aside>
</footer>
  
  <!-- LINE Coupon and Chat -->
  {import.meta.env.PUBLIC_LINE_SHARE_ID && (
    <>
      <a 
        href={config.link.line} 
        class="fixed bottom-20 xs:bottom-24 right-20 xs:right-24 z-20 shadow-xl opacity-90"
      >
        <img width="160" height="60" src="/coupon/line.webp" alt="line coupon" />
      </a>
      <a 
        href={`https://lin.ee/${import.meta.env.PUBLIC_LINE_SHARE_ID}`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-circle fixed bottom-20 xs:bottom-24 right-4 xs:right-6 z-20 text-stone-50 bg-green-600 hover:bg-green-700"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.875 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.736c.345 0 .627.283.627.629 0 .344-.282.629-.627.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
        </svg>
      </a>
    </>
  )}
</footer>